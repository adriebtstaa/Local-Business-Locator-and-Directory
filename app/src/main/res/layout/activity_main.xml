<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <EditText
        android:id="@+id/searchEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search businesses..."
        android:inputType="text"
        android:padding="12dp"
        android:layout_margin="8dp"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <Button
                android:id="@+id/btnAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnResort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resort"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnFood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Food"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnMarket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shop"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnCafe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cafe"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnPharmacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pharmacy"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnOwnerSignUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Owner Sign Up"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnGuestComment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guest Comment"/>

        </LinearLayout>
    </HorizontalScrollView>

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerBusiness"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>
