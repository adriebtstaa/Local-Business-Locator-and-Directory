<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity"
    android:background="#F5F5F5">

    <!-- Directory Header (Businesslist.ph Style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#3F51B5"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PinBiz"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:textColor="@android:color/white"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nasugbu Business Locator &amp; Mapping System"
            android:textSize="12sp"
            android:textColor="#E0E0E0"
            android:layout_marginTop="1dp"/>

        <TextView
            android:id="@+id/textDirectorySubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Find resorts, restaurants, cafes &amp; shops in Batangas"
            android:textSize="13sp"
            android:textColor="#E0E0E0"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <EditText
        android:id="@+id/searchEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search businesses by name or barangay..."
        android:inputType="text"
        android:padding="12dp"
        android:layout_margin="8dp"
        android:background="@drawable/ic_launcher_background"
        android:backgroundTint="@android:color/white"
        android:elevation="2dp"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <Button
                android:id="@+id/btnAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnResort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resorts"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnFood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Food"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnMarket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shops"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnCafe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cafes"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnPharmacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pharmacy"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnOwnerSignUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Register"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnGuestComment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Review"/>

        </LinearLayout>
    </HorizontalScrollView>

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="4dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Featured Business Listings &amp; Map Results"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerBusiness"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="8dp"
        android:layout_weight="1" />

</LinearLayout>
