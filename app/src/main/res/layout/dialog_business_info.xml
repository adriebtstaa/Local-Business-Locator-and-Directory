<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    android:background="#F9FBF9">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header Banner / Image Preview -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="#4E6C50"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/dialogImageBanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Location Photo"/>

                <!-- Gradient Overlay for aesthetics -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#33000000"/>

                <!-- Category Badge on Banner -->
                <TextView
                    android:id="@+id/dialogBadgeCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RESORT"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:background="#6D8B9D"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="12dp"/>
            </FrameLayout>

            <!-- Business Name -->
            <TextView
                android:id="@+id/dialogTextName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Business Name"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#2D3732"/>

            <!-- Display Info / Subtitle -->
            <TextView
                android:id="@+id/dialogTextDisplayInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resort in Bucana"
                android:textSize="14sp"
                android:textColor="#587B60"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D8E2DC"
                android:layout_marginVertical="12dp"/>

            <!-- Details Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F0F4F1"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/dialogTextDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Address: ...\nPhone: ...\nOwner: ...\nRating: 4.5★"
                    android:textSize="14sp"
                    android:textColor="#3D4A43"
                    android:lineSpacingExtra="5dp"/>
            </LinearLayout>

            <!-- Reviews Section Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Customer Reviews &amp; Ratings"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#2D3732"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/dialogTextReviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No reviews yet."
                android:textSize="13sp"
                android:textColor="#556B61"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="20dp"/>

            <!-- Action Buttons (Sage Blue & Sage Brown Theme) -->
            <Button
                android:id="@+id/dialogBtnDirections"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Get Directions / Route"
                android:textColor="@android:color/white"
                android:backgroundTint="#6D8B9D"
                android:textStyle="bold"
                android:elevation="2dp"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/dialogBtnReview"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="✍Write Review &amp; Rate"
                android:textColor="@android:color/white"
                android:backgroundTint="#8B7355"
                android:textStyle="bold"
                android:elevation="2dp"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/dialogBtnClose"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Close"
                android:textColor="#4A5D54"
                android:backgroundTint="#E2ECE9"
                android:textStyle="bold"
                android:elevation="0dp"/>

        </LinearLayout>
    </ScrollView>
</androidx.cardview.widget.CardView>
