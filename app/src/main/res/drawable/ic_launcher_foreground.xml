<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- White Circle Background -->
    <path
        android:pathData="M54,54m-50,0a50,50 0,1 1,100 0a50,50 0,1 1,-100 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="20"
                android:startY="20"
                android:endX="88"
                android:endY="88"
                android:type="linear">
                <item
                    android:color="#FFFFFF"
                    android:offset="0.0" />
                <item
                    android:color="#E0E0E0"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Location Pin -->
    <path
        android:pathData="M54,20C42,20 33,29 33,41C33,57 54,80 54,80C54,80 75,57 75,41C75,29 66,20 54,20Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="33"
                android:startY="20"
                android:endX="75"
                android:endY="80"
                android:type="linear">
                <item
                    android:color="#009688"
                    android:offset="0.0" />
                <item
                    android:color="#00796B"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner White Circle -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,33m-10,0a10,10 0,1 1,20 0a10,10 0,1 1,-20 0" />

    <!-- Center Gold Dot -->
